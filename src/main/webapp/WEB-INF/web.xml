<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>JobTrack</display-name>

    <!-- ==================================================================== -->
    <!-- Application Lifecycle Listeners                                      -->
    <!-- DatabaseContextListener manages HikariCP initialization and shutdown -->
    <!-- ==================================================================== -->
    <listener>
        <listener-class>com.jobtrack.util.DatabaseContextListener</listener-class>
    </listener>

    <!-- ==================================================================== -->
    <!-- Filter Definitions & Ordered Filter Chains                           -->
    <!-- Execution Order:                                                     -->
    <!-- 1. AuthenticationFilter (Session validation & route guarding)        -->
    <!-- 2. CsrfFilter (State-changing CSRF token validation)                 -->
    <!-- ==================================================================== -->

    <!-- Filter 1: Authentication Filter -->
    <filter>
        <filter-name>AuthenticationFilter</filter-name>
        <filter-class>com.jobtrack.filter.AuthenticationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Filter 2: CSRF Protection Filter -->
    <filter>
        <filter-name>CsrfFilter</filter-name>
        <filter-class>com.jobtrack.filter.CsrfFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CsrfFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ==================================================================== -->
    <!-- Session Security Configuration                                       -->
    <!-- ==================================================================== -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- ==================================================================== -->
    <!-- Welcome File List                                                    -->
    <!-- ==================================================================== -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

</web-app>
